# Kept as .draft (not included by databricks.yml) until my own deploy, so another window's deploy cannot pick up a
# half-written job. At deploy: rename to backtest.job.yml, then `databricks bundle validate -t dev`, then deploy.
# The environment pins below are checked against serverless environment 4 at that point.
resources:
  experiments:
    # One MLflow experiment for every back-test run (docs/design/backtest.md §7).
    backtest:
      name: /Workspace/Users/${workspace.current_user.userName}/coolcheck-backtest

  jobs:
    # Rolling back-test: 14 monthly folds Jul 2025 to Aug 2026, three baselines, ablations, MLflow runs and a report.
    backtest:
      name: coolcheck backtest
      max_concurrent_runs: 1
      timeout_seconds: 3600
      parameters:
        - name: cutoff_minutes
          default: "15"
        - name: bootstrap
          default: "2000"
        - name: folds
          default: "14"
      environments:
        - environment_key: ml
          spec:
            environment_version: "4"
            dependencies:
              - lightgbm==4.6.0
              - scikit-learn==1.9.1
              - mlflow-skinny==3.17.2
      tasks:
        - task_key: backtest
          max_retries: 0
          environment_key: ml
          spark_python_task:
            python_file: ../src/jobs/backtest.py
            parameters:
              - --catalog
              - ${var.catalog}
              - --src
              - ${workspace.file_path}/src
              - --experiment-id
              - ${resources.experiments.backtest.id}
              - --git-sha
              - ${bundle.git.commit}
              - --cutoff-minutes
              - "{{job.parameters.cutoff_minutes}}"
              - --bootstrap
              - "{{job.parameters.bootstrap}}"
              - --folds
              - "{{job.parameters.folds}}"
