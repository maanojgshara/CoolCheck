{
  "datasets": [
    {
      "name": "ds_thirds_map",
      "displayName": "Vulnerability third map",
      "queryLines": [
        "SELECT m.planning_area AS area_name, m.geometry, v.third,\n",
        "  CASE v.third WHEN 'lower' THEN 1 WHEN 'middle' THEN 2 WHEN 'upper' THEN 3 END AS third_code\n",
        "FROM planning_area_map m JOIN area_vulnerability v ON v.planning_area = m.planning_area\n"
      ]
    },
    {
      "name": "ds_area_facts",
      "displayName": "Area facts",
      "queryLines": [
        "SELECT planning_area, initcap(third) AS third, reason, aged_75_plus, rental_1_2_room, hdb_dwelling_units_confirmed,\n",
        "  concat(format_number(100 * refuge_beyond_400m, 0), '%') AS refuge_beyond,\n",
        "  concat(format_number(100 * park_beyond_400m, 0), '%') AS park_beyond,\n",
        "  coalesce(neutral_components, '') AS held_neutral\n",
        "FROM area_vulnerability\n"
      ]
    },
    {
      "name": "ds_blocks",
      "displayName": "Blocks in priority order",
      "queryLines": [
        "SELECT planning_area, priority, concat(blk_no, ' ', street) AS block, rental_1_2_room, total_dwelling_units,\n",
        "  refuge_main_name, CAST(round(refuge_main_m) AS INT) AS refuge_m,\n",
        "  CASE WHEN refuge_within_400m THEN 'yes' ELSE 'no' END AS refuge_400m,\n",
        "  park_main_name, CAST(round(park_main_m) AS INT) AS park_m,\n",
        "  CASE WHEN park_within_400m THEN 'yes' ELSE 'no' END AS park_400m,\n",
        "  CASE WHEN confirmed THEN '' ELSE 'coordinate from a tenant record' END AS note\n",
        "FROM block_vulnerability\n",
        "ORDER BY planning_area, priority\n"
      ]
    },
    {
      "name": "ds_points",
      "displayName": "Blocks and refuges",
      "queryLines": [
        "SELECT planning_area, lat, lon,\n",
        "  CASE WHEN refuge_within_400m THEN 'Block within 400 m of a refuge' ELSE 'Block beyond 400 m of a refuge' END AS point_type,\n",
        "  concat(blk_no, ' ', street) AS label, greatest(rental_1_2_room, 1) AS marker_size,\n",
        "  concat('priority ', CAST(priority AS STRING), '; 1-2 room rental flats ', CAST(rental_1_2_room AS STRING)) AS detail\n",
        "FROM block_vulnerability\n",
        "UNION ALL\n",
        "SELECT planning_area, lat, lon, 'Refuge' AS point_type, name AS label, 30 AS marker_size, refuge_type AS detail\n",
        "FROM refuge_layer\n"
      ]
    },
    {
      "name": "ds_parks",
      "displayName": "Parks",
      "queryLines": [
        "SELECT planning_area, park_name, geometry, 1 AS park\n",
        "FROM park_layer\n"
      ]
    },
    {
      "name": "ds_weights",
      "displayName": "Weights",
      "queryLines": [
        "SELECT component, sub_index, weight, direction, small_area_rule, reason_phrase, review_status\n",
        "FROM score_weights\n",
        "ORDER BY sort_order\n"
      ]
    },
    {
      "name": "ds_actions",
      "displayName": "Actions per tier",
      "queryLines": [
        "SELECT tier, actions, review_status\n",
        "FROM tier_actions\n",
        "ORDER BY CASE tier WHEN 'High' THEN 1 WHEN 'Medium' THEN 2 WHEN 'Low' THEN 3 ELSE 4 END\n"
      ]
    }
  ],
